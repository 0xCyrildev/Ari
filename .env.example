# Ari — local development configuration. Copy to .env
#
# Ports chosen to avoid collisions with services already running on this host
# (5432/5433 postgres, 6380 redis, 3000 next, 8000 plausible, 8545 anvil).

NODE_ENV=development
LOG_LEVEL=info

# --- decision plane -------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000

# --- datastores -----------------------------------------------------------
DATABASE_URL=postgresql://ari:ari@127.0.0.1:5435/ari?schema=public
REDIS_URL=redis://127.0.0.1:6381

# --- secrets --------------------------------------------------------------
# Generate with: openssl rand -base64 48
#
# TICKET_KEY   seals AuthorizationTickets. Held by BOTH ari-api (mint) and
#              ari-signer (verify). Rotating it invalidates every outstanding
#              ticket, which is the intended panic response.
TICKET_KEY=
# PEPPER       org-scoped credential lookup pepper. Lives OUTSIDE the database;
#              a stolen credentials table must not be a usable credentials table.
CREDENTIAL_PEPPER=
# APPROVAL_KEY binds approval tokens to a canonical digest (single-use).
APPROVAL_KEY=

# --- bootstrap ------------------------------------------------------------
# One-time credential for POST /v1/organizations. Ari has no open signup:
# an organisation is a tenant boundary, not a registration form.
ORG_BOOTSTRAP_TOKEN=

# --- signing / simulation providers --------------------------------------
# 'mock' is the only value that must work before Phase 8. Anything else here
# fails startup rather than silently falling back to mock — a config typo must
# never downgrade a real deployment to a mock signer.
SIGNING_PROVIDER=mock
SIMULATION_PROVIDER=mock

# --- authority plane (ari-signer) ------------------------------------------
# The wallets THIS process holds capacity for. A signer that names no wallet
# refuses to start rather than running as a service that can never sign.
SIGNER_WALLETS=
SIGNER_PORT=4100

# Present only when SIGNING_PROVIDER=ika. Left blank in the baseline because
# the adapter is Phase 8 and ASSUMPTIONS.md §6 is not closed yet.
IKA_NETWORK=
SUI_GRPC_URL=

# --- intent engine --------------------------------------------------------
# Optional. Empty INTENT_MODE means deterministic-only: the model is never
# called and agents must submit structured transactions. That is a supported
# production mode, not a degraded one (THREAT_MODEL T22).
INTENT_MODE=deterministic_only
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
