{
  "name": "ari",
  "private": true,
  "license": "BUSL-1.1",
  "version": "0.0.0",
  "description": "Ari \u2014 permission infrastructure for autonomous money",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "client:build": "pnpm --filter @ari/client build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run packages tests/unit apps",
    "test:security": "vitest run tests/security",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "node --import tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:preflight": "node --import tsx --env-file-if-exists=.env scripts/preflight.mts",
    "clean": "rm -rf packages/*/dist node_modules/.vite",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='packages/*/src/**' --coverage.reporters=text",
    "seed": "node --import tsx --env-file-if-exists=.env scripts/seed-tenant.mts",
    "ari": "node --import tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "web:preflight": "pnpm --dir apps/web preflight",
    "web:sweep": "pnpm --dir apps/web sweep",
    "web:why-overflow": "pnpm --dir apps/web why-overflow",
    "web:lines": "pnpm --dir apps/web lines",
    "web:dev": "pnpm --dir apps/web dev",
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "web:build": "pnpm --dir apps/web build"
  },
  "devDependencies": {
    "@ari/api": "workspace:*",
    "@ari/approvals": "workspace:*",
    "@ari/audit": "workspace:*",
    "@ari/cli": "workspace:*",
    "@ari/client": "workspace:*",
    "@ari/identity": "workspace:*",
    "@ari/ledger": "workspace:*",
    "@ari/policies": "workspace:*",
    "@ari/policy-engine": "workspace:*",
    "@ari/reconciliation": "workspace:*",
    "@ari/risk-engine": "workspace:*",
    "@ari/schemas": "workspace:*",
    "@ari/signing": "workspace:*",
    "@ari/transaction-engine": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.2",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "@ari/simulation": "workspace:*"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "tsx": "^4.23.15"
  }
}
