{
  "name": "ari",
  "private": true,
  "version": "0.0.0",
  "description": "Ari — permission infrastructure for autonomous money",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run packages",
    "test:security": "vitest run --dir tests/security",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "clean": "rm -rf packages/*/dist node_modules/.vite",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='packages/*/src/**' --coverage.reporters=text"
  },
  "devDependencies": {
    "@ari/api": "workspace:*",
    "@ari/approvals": "workspace:*",
    "@ari/audit": "workspace:*",
    "@ari/client": "workspace:*",
    "@ari/identity": "workspace:*",
    "@ari/ledger": "workspace:*",
    "@ari/policies": "workspace:*",
    "@ari/policy-engine": "workspace:*",
    "@ari/risk-engine": "workspace:*",
    "@ari/schemas": "workspace:*",
    "@ari/signing": "workspace:*",
    "@ari/transaction-engine": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.2",
    "pg": "8.23.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1"
  }
}
